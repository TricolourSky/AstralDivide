<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AstralDivide</AssemblyName>
    <RootNamespace>AstralDivide</RootNamespace>
    <Version>0.1.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- 本机 SPT 服务端目录; 外部构建用 dotnet build -p:SptDir=<路径> 覆写 -->
    <SptDir Condition="'$(SptDir)' == ''">D:\SPT\SPT_Runtime</SptDir>
    <ModRoot>$(MSBuildProjectDirectory)\..</ModRoot>
    <ModDir>$(SptDir)\user\mods\AstralDivide</ModDir>
  </PropertyGroup>

  <!--
    ⚠️ 照**最低支持版本**的官方包编译，不要引本机安装目录里的 DLL。
    .NET 只肯绑定「不低于引用版本」的程序集：照本机 4.1.6 / WTT 3.0.6 编，DLL 里记的引用就是 4.1.6.0 / 3.0.6.0，
    装在 4.1.0~4.1.5 的服务端上直接加载失败 —— ModMetadata 里声明的 ~4.1.0 / ~3.0.0 就成了空话（2026-10-02 栽过）。
    这两个版本号要和 ModMetadata.SptVersion / ModDependencies 的下限保持一致。
    ExcludeAssets=runtime：只拿来编译，不往输出目录拷（运行时用的是服务端自己那份）。
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!--
    编译后自动部署。bundles 有 200MB+，SkipUnchangedFiles 让第二次以后只拷改动过的，
    否则每次编译都要搬两百兆。
  -->
  <Target Name="Deploy" AfterTargets="Build">
    <ItemGroup>
      <DbFiles Include="$(ModRoot)\db\**\*.*" />
      <BundleFiles Include="$(ModRoot)\bundles\**\*.*" />
      <ResFiles Include="$(ModRoot)\res\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDir)" />
    <Copy SourceFiles="$(ModRoot)\LICENSE;$(ModRoot)\NOTICE.txt" DestinationFolder="$(ModDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ModRoot)\bundles.json" DestinationFolder="$(ModDir)"
          Condition="Exists('$(ModRoot)\bundles.json')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DbFiles)"     DestinationFolder="$(ModDir)\db\%(RecursiveDir)"      SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BundleFiles)" DestinationFolder="$(ModDir)\bundles\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ResFiles)"    DestinationFolder="$(ModDir)\res\%(RecursiveDir)"     SkipUnchangedFiles="true" />
    <Message Importance="high" Text="已部署: AstralDivide -> $(ModDir)" />
  </Target>

</Project>
